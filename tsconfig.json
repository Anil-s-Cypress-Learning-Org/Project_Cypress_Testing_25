{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "target": "es5",
        "lib": [
            "dom"
        ],
        "types": [
            "cypress",
            "node",
            "cypress-iframe"
            // "jquery"
        ]
        // "baseUrl": "./", // Optional: Specify your project's base directory
        // "paths": { "@/*": ["src/*"] } // Optional: Custom path aliases
    },
    "baseUrl": "./",
    "paths": {
        "@cypress/*": [
            "../cypress/*"
        ],
        "@support/*": [
            "../cypress/support/*"
        ],
        "@fixtures/*": [
            "../cypress/fixture"
        ],
    },
    "include": [
        "cypress/**/**/*.ts",
        "cypress/support/@DocTypes/commands.d.ts",
        "cypress.d.ts"
    ],
    "exclude": [
        "node_modules",
        "typings"
    ]
}